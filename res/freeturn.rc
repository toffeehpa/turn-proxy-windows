#pragma code_page(65001)

#include <winres.h>
#include "resource.h"
#include "core/version_rc.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDI_APP                 ICON    "icons/freeturn.ico"
IDI_TRAY_OFF            ICON    "icons/tray-off.ico"
IDI_TRAY_CONNECTING     ICON    "icons/tray-connecting.ico"
IDI_TRAY_ON             ICON    "icons/tray-on.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

// Тексты окон ставит код из strings.cpp - здесь только раскладка.
IDD_PROFILE DIALOGEX 0, 0, 320, 128
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_LBL_LINK, 7, 10, 100, 8
    EDITTEXT        IDC_LINK, 110, 7, 150, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "", IDC_PASTE, 264, 7, 49, 14
    LTEXT           "", IDC_LBL_NAME, 7, 28, 100, 8
    EDITTEXT        IDC_NAME, 110, 25, 203, 14, ES_AUTOHSCROLL
    LTEXT           "", IDC_LBL_LINKS, 7, 46, 100, 8
    EDITTEXT        IDC_LINKS, 110, 43, 150, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "", IDC_CALLS, 264, 43, 49, 14
    LTEXT           "", IDC_LBL_TRANSPORT, 7, 62, 100, 8
    AUTORADIOBUTTON "", IDC_TRANSPORT_UDP, 110, 61, 45, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "", IDC_TRANSPORT_TCP, 160, 61, 45, 10
    LTEXT           "", IDC_LBL_STREAMS, 7, 80, 100, 8
    CONTROL         "", IDC_STREAMS, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP | WS_GROUP, 106, 77, 207, 14
    LTEXT           "", IDC_STREAMS_HINT, 110, 92, 203, 8
    // Дополнительно: в свёрнутом окне скрыто, кнопки ниже переезжают под эти поля.
    PUSHBUTTON      "", IDC_FROM_FILE, 110, 125, 80, 14
    LTEXT           "", IDC_LBL_PROVIDER, 7, 146, 100, 8
    COMBOBOX        IDC_PROVIDER, 110, 143, 203, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_LBL_PEER, 7, 164, 100, 8
    EDITTEXT        IDC_PEER, 110, 161, 203, 14, ES_AUTOHSCROLL
    LTEXT           "", IDC_LBL_LISTEN, 7, 182, 100, 8
    EDITTEXT        IDC_LISTEN, 110, 179, 203, 14, ES_AUTOHSCROLL
    LTEXT           "", IDC_LBL_MODE, 7, 200, 100, 8
    COMBOBOX        IDC_MODE, 110, 197, 203, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_LBL_PER_CRED, 7, 218, 100, 8
    CONTROL         "", IDC_PER_CRED, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 106, 215, 207, 14
    LTEXT           "", IDC_PER_CRED_HINT, 110, 230, 203, 8
    LTEXT           "", IDC_LBL_OBF, 7, 246, 100, 8
    COMBOBOX        IDC_OBF, 110, 243, 203, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_LBL_OBF_KEY, 7, 264, 100, 8
    EDITTEXT        IDC_OBF_KEY, 110, 261, 203, 14, ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT           "", IDC_LBL_OBF_TIMING, 7, 282, 100, 8
    EDITTEXT        IDC_OBF_TIMING, 110, 279, 50, 14, ES_NUMBER
    LTEXT           "", IDC_OBF_UNIT, 164, 282, 30, 8
    LTEXT           "", IDC_LBL_CLIENT_ID, 7, 300, 100, 8
    EDITTEXT        IDC_CLIENT_ID, 110, 297, 203, 14, ES_AUTOHSCROLL
    AUTOCHECKBOX    "", IDC_MANUAL_CAPTCHA, 110, 315, 100, 10
    AUTOCHECKBOX    "", IDC_BOND, 215, 315, 98, 10
    PUSHBUTTON      "", IDC_ADVANCED, 7, 107, 80, 14
    DEFPUSHBUTTON   "OK", IDOK, 209, 107, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 263, 107, 50, 14
END

IDD_CALLS DIALOGEX 0, 0, 260, 170
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_LBL_CALL_NEW, 7, 7, 246, 8
    EDITTEXT        IDC_CALL_NEW, 7, 18, 190, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "", IDC_CALL_ADD, 201, 18, 52, 14
    LISTBOX         IDC_CALL_LIST, 7, 38, 190, 104, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON      "", IDC_CALL_UP, 201, 38, 52, 14
    PUSHBUTTON      "", IDC_CALL_DOWN, 201, 56, 52, 14
    PUSHBUTTON      "", IDC_CALL_REMOVE, 201, 74, 52, 14
    AUTOCHECKBOX    "", IDC_ROLLING, 7, 151, 75, 10
    DEFPUSHBUTTON   "OK", IDOK, 149, 149, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 203, 149, 50, 14
END

IDD_ABOUT DIALOGEX 0, 0, 280, 140
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_ABOUT_LOGO, "Static", SS_ICON, 7, 7, 30, 30
    LTEXT           "", IDC_ABOUT_APP, 46, 9, 227, 28, SS_NOPREFIX
    LTEXT           "", IDC_ABOUT_CORE, 7, 48, 266, 44, SS_NOPREFIX
    LTEXT           "", IDC_ABOUT_WINTUN, 7, 98, 266, 10, SS_NOPREFIX
    PUSHBUTTON      "", IDC_ABOUT_UPDATES, 117, 119, 100, 14
    DEFPUSHBUTTON   "OK", IDOK, 223, 119, 50, 14
END

IDD_SETTINGS DIALOGEX 0, 0, 300, 179
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "", IDC_GRP_STARTUP, 7, 7, 286, 56
    AUTOCHECKBOX    "", IDC_LAUNCH_ON_LOGON, 16, 18, 270, 10
    AUTOCHECKBOX    "", IDC_CONNECT_ON_START, 16, 32, 270, 10
    AUTOCHECKBOX    "", IDC_AUTO_RECONNECT, 16, 46, 270, 10
    GROUPBOX        "", IDC_GRP_LOG, 7, 70, 286, 46
    AUTOCHECKBOX    "", IDC_VERBOSE_LOG, 16, 81, 270, 10
    PUSHBUTTON      "", IDC_OPEN_LOG, 16, 95, 90, 14
    PUSHBUTTON      "", IDC_OPEN_DATA, 110, 95, 110, 14
    GROUPBOX        "", IDC_GRP_EXPERIMENTAL, 7, 123, 286, 28
    AUTOCHECKBOX    "", IDC_EXPERIMENTAL_SFU, 16, 134, 270, 10
    PUSHBUTTON      "", IDC_ABOUT, 7, 158, 90, 14
    DEFPUSHBUTTON   "OK", IDOK, 189, 158, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 243, 158, 50, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     FT_VERSION_MAJOR, FT_VERSION_MINOR, FT_VERSION_PATCH, 0
PRODUCTVERSION  FT_VERSION_MAJOR, FT_VERSION_MINOR, FT_VERSION_PATCH, 0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "FreeTurn"
            VALUE "FileDescription", "FreeTurn"
            VALUE "FileVersion", FT_VERSION_STRING
            VALUE "InternalName", "FreeTurn"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "FreeTurn.exe"
            VALUE "ProductName", "FreeTurn"
            VALUE "ProductVersion", FT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
