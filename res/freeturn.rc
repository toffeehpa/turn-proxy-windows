#pragma code_page(65001)

#include <winres.h>
#include "resource.h"
#include "core/version_rc.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDI_APP                 ICON    "icons/freeturn.ico"
IDI_TRAY_OFF            ICON    "icons/tray-off.ico"
IDI_TRAY_CONNECTING     ICON    "icons/tray-connecting.ico"
IDI_TRAY_ON             ICON    "icons/tray-on.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

// Тексты окон ставит код из strings.cpp - здесь только раскладка.
IDD_PROFILE DIALOGEX 0, 0, 320, 293
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_LBL_LINK, 7, 7, 306, 8
    EDITTEXT        IDC_LINK, 7, 18, 200, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "", IDC_PASTE, 211, 18, 50, 14
    PUSHBUTTON      "", IDC_FROM_FILE, 265, 18, 48, 14
    LTEXT           "", IDC_LBL_NAME, 7, 41, 100, 8
    EDITTEXT        IDC_NAME, 110, 38, 203, 14, ES_AUTOHSCROLL
    LTEXT           "", IDC_LBL_PROVIDER, 7, 59, 100, 8
    COMBOBOX        IDC_PROVIDER, 110, 56, 203, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_LBL_PEER, 7, 77, 100, 8
    EDITTEXT        IDC_PEER, 110, 74, 203, 14, ES_AUTOHSCROLL
    LTEXT           "", IDC_LBL_LINKS, 7, 95, 100, 26
    EDITTEXT        IDC_LINKS, 110, 92, 203, 36, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
    LTEXT           "", IDC_LBL_LISTEN, 7, 135, 100, 8
    EDITTEXT        IDC_LISTEN, 110, 132, 203, 14, ES_AUTOHSCROLL
    LTEXT           "", IDC_LBL_MODE, 7, 153, 100, 8
    COMBOBOX        IDC_MODE, 110, 150, 203, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_LBL_TRANSPORT, 7, 171, 100, 8
    COMBOBOX        IDC_TRANSPORT, 110, 168, 203, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_LBL_STREAMS, 7, 189, 100, 8
    EDITTEXT        IDC_STREAMS, 110, 186, 50, 14, ES_NUMBER
    LTEXT           "", IDC_LBL_OBF, 7, 207, 100, 8
    COMBOBOX        IDC_OBF, 110, 204, 203, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_LBL_OBF_KEY, 7, 225, 100, 8
    EDITTEXT        IDC_OBF_KEY, 110, 222, 203, 14, ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT           "", IDC_LBL_CLIENT_ID, 7, 243, 100, 8
    EDITTEXT        IDC_CLIENT_ID, 110, 240, 203, 14, ES_AUTOHSCROLL
    AUTOCHECKBOX    "", IDC_MANUAL_CAPTCHA, 110, 258, 100, 10
    AUTOCHECKBOX    "", IDC_BOND, 215, 258, 98, 10
    DEFPUSHBUTTON   "OK", IDOK, 209, 272, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 263, 272, 50, 14
END

IDD_ABOUT DIALOGEX 0, 0, 280, 140
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_ABOUT_LOGO, "Static", SS_ICON, 7, 7, 30, 30
    LTEXT           "", IDC_ABOUT_APP, 46, 9, 227, 28, SS_NOPREFIX
    LTEXT           "", IDC_ABOUT_CORE, 7, 48, 266, 44, SS_NOPREFIX
    LTEXT           "", IDC_ABOUT_WINTUN, 7, 98, 266, 10, SS_NOPREFIX
    PUSHBUTTON      "", IDC_ABOUT_UPDATES, 117, 119, 100, 14
    DEFPUSHBUTTON   "OK", IDOK, 223, 119, 50, 14
END

IDD_SETTINGS DIALOGEX 0, 0, 300, 165
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "", IDC_GRP_STARTUP, 7, 7, 286, 42
    AUTOCHECKBOX    "", IDC_CONNECT_ON_START, 16, 18, 270, 10
    AUTOCHECKBOX    "", IDC_AUTO_RECONNECT, 16, 32, 270, 10
    GROUPBOX        "", IDC_GRP_LOG, 7, 56, 286, 46
    AUTOCHECKBOX    "", IDC_VERBOSE_LOG, 16, 67, 270, 10
    PUSHBUTTON      "", IDC_OPEN_LOG, 16, 81, 90, 14
    PUSHBUTTON      "", IDC_OPEN_DATA, 110, 81, 110, 14
    GROUPBOX        "", IDC_GRP_EXPERIMENTAL, 7, 109, 286, 28
    AUTOCHECKBOX    "", IDC_EXPERIMENTAL_SFU, 16, 120, 270, 10
    PUSHBUTTON      "", IDC_ABOUT, 7, 144, 90, 14
    DEFPUSHBUTTON   "OK", IDOK, 189, 144, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 243, 144, 50, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     FT_VERSION_MAJOR, FT_VERSION_MINOR, FT_VERSION_PATCH, 0
PRODUCTVERSION  FT_VERSION_MAJOR, FT_VERSION_MINOR, FT_VERSION_PATCH, 0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "FreeTurn"
            VALUE "FileDescription", "FreeTurn"
            VALUE "FileVersion", FT_VERSION_STRING
            VALUE "InternalName", "FreeTurn"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "FreeTurn.exe"
            VALUE "ProductName", "FreeTurn"
            VALUE "ProductVersion", FT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
