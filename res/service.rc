#pragma code_page(65001)

#include <winres.h>
#include "resource.h"
#include "core/version_rc.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDI_APP                 ICON    "icons/freeturn.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     FT_VERSION_MAJOR, FT_VERSION_MINOR, FT_VERSION_PATCH, 0
PRODUCTVERSION  FT_VERSION_MAJOR, FT_VERSION_MINOR, FT_VERSION_PATCH, 0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "FreeTurn"
            VALUE "FileDescription", "FreeTurn Service"
            VALUE "FileVersion", FT_VERSION_STRING
            VALUE "InternalName", "freeturn-service"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "freeturn-service.exe"
            VALUE "ProductName", "FreeTurn"
            VALUE "ProductVersion", FT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
